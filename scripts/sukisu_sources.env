# Resolve the rolling manager-ci release at build time. The source checkout,
# Manager APK, and kernel version are paired to the same release target commit.
SUKISU_REPOSITORY=https://github.com/SukiSU-Nova/SukiSU-Nova.git
SUKISU_REPOSITORY_FALLBACK=https://git.zako.shirkneko.top:20004/shirkneko/SukiSU.git
SUKISU_CI_API=https://git.zako.shirkneko.top:20004/api/v1/repos/shirkneko/SukiSU
SUKISU_CI_RELEASE_URL=https://cnb.cool/sukisu-nova/Release/-/tree/manager-ci
SUKISU_CI_MANIFEST_URL=https://cnb.cool/sukisu-nova/Release/-/git/raw/manager-ci/manifest.json
SUKISU_CI_TAG=manager-ci
# The manifest is the primary source for the rolling APK set. Keep the tree
# URL as a human-readable fallback page and for older CNB layouts.
SUKISU_CI_FALLBACK_RELEASE_URL=https://cnb.cool/sukisu-nova/Release/-/tree/manager-ci
SUKISU_CI_MAX_ATTEMPTS=20
SUKISU_CI_RETRY_SECONDS=30
# The CI Manager is built from main; builtin is the separate SUSFS source.
SUKISU_VERSION_BASE=30000
SUKISU_SUSFS_REPOSITORY=https://github.com/cctv18/susfs4oki.git
SUKISU_SUSFS_BRANCH=oki-android15-6.6
SUSFS_MODULE_REPOSITORY=sidex15/susfs4ksu-module
SUSFS_MODULE_WORKFLOW=build.yml
SUSFS_MODULE_BRANCH=v1.5.2+
SUSFS_MODULE_ARTIFACT_PREFIX=release-1.5.2+_
